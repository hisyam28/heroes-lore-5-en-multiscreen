+package co.kr.eamobile.hl5.runner;
+import android.content.Context;
+import android.util.AtomicFile;
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.security.MessageDigest;
+import org.json.JSONObject;
+final class TargetAssets {
+    private static JSONObject readJson(InputStream input) throws Exception {
+        ByteArrayOutputStream out=new ByteArrayOutputStream(); byte[] b=new byte[4096]; int n;
+        while((n=input.read(b))!=-1) out.write(b,0,n);
+        return new JSONObject(new String(out.toByteArray(),StandardCharsets.UTF_8));
+    }
+    private static String hex(byte[] bytes) {
+        char[] chars="0123456789abcdef".toCharArray(),out=new char[bytes.length*2];
+        for(int i=0;i<bytes.length;i++){out[i*2]=chars[(bytes[i]&255)>>>4];out[i*2+1]=chars[bytes[i]&15];}
+        return new String(out);
+    }
+    private static String digest(InputStream input) throws Exception {
+        MessageDigest sha=MessageDigest.getInstance("SHA-256");byte[] b=new byte[65536];int n;
+        while((n=input.read(b))!=-1)sha.update(b,0,n);
+        return hex(sha.digest());
+    }
+    static boolean cacheMatches(File file,JSONObject stamp,String hash) {
+        return stamp!=null && file.isFile() && hash.equals(stamp.optString("sha256"))
+            && file.length()==stamp.optLong("length",-1) && file.lastModified()==stamp.optLong("modified",-1);
+    }
+    static synchronized void install(Context context,File directory) throws Exception {
+        if(directory==null)throw new IOException("Internal storage unavailable");
+        JSONObject expected;
+        try(InputStream input=context.getAssets().open("target-assets.json")){expected=readJson(input);}
+        AtomicFile cache=new AtomicFile(new File(directory,"runner-assets-verified.json"));
+        JSONObject stamps;
+        try(InputStream input=cache.openRead()){stamps=readJson(input);}
+        catch(Exception missing){stamps=new JSONObject();}
+        boolean changed=false;
+        for(String name:new String[]{"libHeroesLore5.so","data.vfs.mp3"}){
+            String hash=expected.getString(name);
+            AtomicFile target=new AtomicFile(new File(directory,name));File base=target.getBaseFile();
+            if(!new File(base.getPath()+".bak").exists() && !new File(base.getPath()+".new").exists()
+                && cacheMatches(base,stamps.optJSONObject(name),hash))continue;
+            boolean verified=false;
+            try(InputStream input=target.openRead()){verified=hash.equals(digest(input));}
+            catch(FileNotFoundException missing){}
+            if(!verified){
+                FileOutputStream output=null;
+                try(InputStream input=context.getAssets().open(name)){
+                    output=target.startWrite();MessageDigest sha=MessageDigest.getInstance("SHA-256");
+                    byte[] b=new byte[65536];int n;
+                    while((n=input.read(b))!=-1){output.write(b,0,n);sha.update(b,0,n);}
+                    if(!hash.equals(hex(sha.digest())))throw new IOException("Asset fingerprint mismatch: "+name);
+                    target.finishWrite(output);output=null;
+                }finally{if(output!=null)target.failWrite(output);}
+            }
+            stamps.put(name,new JSONObject().put("sha256",hash).put("length",base.length()).put("modified",base.lastModified()));
+            changed=true;
+        }
+        if(changed){
+            FileOutputStream output=null;
+            try{output=cache.startWrite();output.write(stamps.toString().getBytes(StandardCharsets.UTF_8));cache.finishWrite(output);output=null;}
+            finally{if(output!=null)cache.failWrite(output);}
+        }
+    }
+}
