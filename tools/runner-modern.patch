+    uint32_t replacement=allocate_heap(size);
+    std::vector<uint8_t> copy(std::min(old_size,size));
+    if (!read_memory(pointer,copy.data(),copy.size()) || !write_memory(replacement,copy.data(),copy.size())) {
+        free_heap(replacement); throw std::runtime_error("Guest realloc copy failed");
+    }
+    free_heap(pointer); return replacement;
+}
