+uint32_t Arm32NativeEngine::reallocate_heap(uint32_t pointer,uint32_t size) {
+    if (!pointer) return allocate_heap(size);
+    if (!size) { free_heap(pointer); return 0; }
+    if (!heap_ || !heap_->owns(pointer)) throw std::runtime_error("Invalid guest realloc");
+    uint32_t old_size=heap_->requested_size(pointer);
